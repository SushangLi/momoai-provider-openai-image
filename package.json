{
  "name": "momoai-provider-openai-image",
  "version": "0.2.0",
  "description": "MOMOAI provider executor for OpenAI-compatible image generation APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
